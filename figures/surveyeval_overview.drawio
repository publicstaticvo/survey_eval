  <diagram id="surveyeval-overview" name="SurveyEval Overview">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D9E2F0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1560" height="930" as="geometry"/>
        </mxCell>

        <mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;SurveyEval&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5B6B82&quot;&gt;Evidence-linked survey evaluation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D5E5;strokeWidth=1;align=left;spacingLeft=22;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="24" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;Survey PDF / parsed text" style="shape=mxgraph.basic.document;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#5B8DEF;fontColor=#1E3A67;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="335" y="25" width="175" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="revtax" value="&lt;b&gt;RevTax&lt;/b&gt;&lt;br&gt;review taxonomy + labels" style="shape=mxgraph.basic.folder;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#E5A83B;fontColor=#684A11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="545" y="25" width="190" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;STRUCTURAL PARSING&lt;/b&gt;&lt;br&gt;claims &amp; sentence labels &amp; section-topic-paper map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#8BAFE8;fontColor=#26466E;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="25" width="330" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="pool" value="&lt;b&gt;EVIDENCE POOL&lt;/b&gt;&lt;br&gt;academic database + citation graph" style="shape=mxgraph.basic.cylinder;whiteSpace=wrap;html=1;fillColor=#E8FAF4;strokeColor=#54B99A;fontColor=#1C644F;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1135" y="25" width="235" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="toparrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9AAAC0;endArrow=block;" edge="1" parent="1" source="input" target="revtax"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="toparrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9AAAC0;endArrow=block;" edge="1" parent="1" source="revtax" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="toparrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9AAAC0;endArrow=block;" edge="1" parent="1" source="parse" target="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="integrityHeader" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;INTEGRITY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5D6C80&quot;&gt;Categories 1--4: contradictions, errors, and unsupported reasoning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#8595DE;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="740" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="suffHeader" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;SUFFICIENCY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5D6C80&quot;&gt;Categories 5--11: coverage, comparison, references, and topics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9FAF4;strokeColor=#62B99E;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="125" width="740" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;C1  Internal consistency&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Claim pairs: symbols, numbers, coreference&lt;br&gt;VET retrieves the conflicting sentences&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#586A89&quot; style=&quot;font-size:10px&quot;&gt;example: scope promise vs. covered content&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8999DD;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="205" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;C2  Hallucination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Citation lookup + atomic-fact verification&lt;br&gt;local citation -&gt; cited literature -&gt; external search&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#586A89&quot; style=&quot;font-size:10px&quot;&gt;verbatim source span is retained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8999DD;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="205" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;C3  Taxonomic coherence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Unintroduced category: definition search&lt;br&gt;Sibling overlap: shared-literature retrieval + VET&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#586A89&quot; style=&quot;font-size:10px&quot;&gt;LLM judgment is paired with retrievable evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8999DD;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="332" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;C4  Argument support&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Strong or SYNTHESIS claims without citation&lt;br&gt;paragraph -&gt; section evidence search&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#586A89&quot; style=&quot;font-size:10px&quot;&gt;missing support becomes an inspectable finding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8999DD;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="332" width="350" height="112" as="geometry"/></mxCell>

        <mxCell id="c58" value="&lt;b&gt;C5--C8  Genre obligations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GAP / CONTRAST / SYNTHESIS / SCOPE&lt;br&gt;sentence labels mapped to subtopics and research objects&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27745D&quot; style=&quot;font-size:10px&quot;&gt;coverage is computed from the extracted map&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5CB99A;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="790" y="205" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;C9  Novelty&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Contribution statements compared with&lt;br&gt;reference surveys on the same target topic&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27745D&quot; style=&quot;font-size:10px&quot;&gt;title + abstract + contribution evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5CB99A;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1160" y="205" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;C10  Reference anchoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Uncited claim/entity or missing landmark&lt;br&gt;topic-sensitive PPR ranks candidate papers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27745D&quot; style=&quot;font-size:10px&quot;&gt;VET checks whether citation is warranted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5CB99A;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="790" y="332" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;C11  Domain coverage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Citation graph -&gt; multi-resolution Leiden&lt;br&gt;community importance: Miss(C) = [PR(C) - PPR_R(C)]_+&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27745D&quot; style=&quot;font-size:10px&quot;&gt;VET labels communities: covered / mixed / novel / unrelated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5CB99A;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1160" y="332" width="350" height="112" as="geometry"/></mxCell>

        <mxCell id="db" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;EVIDENCE DASHBOARD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5D6C80&quot;&gt;Every output keeps the claim, verbatim evidence, intermediate label, and decision rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#E2B365;strokeWidth=2;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1500" height="62" as="geometry"/></mxCell>

        <mxCell id="dash1" value="&lt;span style=&quot;font-size:28px;color:#E2A63B&quot;&gt;◈&lt;/span&gt;&lt;br&gt;&lt;b&gt;Verified findings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;contradictions, hallucinations,&lt;br&gt;argument-support failures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4C17A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="dash2" value="&lt;span style=&quot;font-size:28px;color:#53B493&quot;&gt;⌕&lt;/span&gt;&lt;br&gt;&lt;b&gt;Ranked candidate list&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;retrieved papers, communities,&lt;br&gt;coverage signals for human inspection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CCDB8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="405" y="570" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="dash3" value="&lt;span style=&quot;font-size:28px;color:#7B89D2&quot;&gt;▤&lt;/span&gt;&lt;br&gt;&lt;b&gt;Official review report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;finding / comment, location,&lt;br&gt;evidence trail, reviewer override&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEB7E8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="570" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="dash4" value="&lt;span style=&quot;font-size:28px;color:#D17CB7&quot;&gt;✓&lt;/span&gt;&lt;br&gt;&lt;b&gt;Human-auditable trail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;source text, paper metadata,&lt;br&gt;retrieval score, VET rationale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A4CB;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1155" y="570" width="375" height="125" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Evidence roles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#7B89D2&quot;&gt;VET&lt;/span&gt; = verifier / evidence tracer &amp;nbsp; • &amp;nbsp; &lt;span style=&quot;color:#53B493&quot;&gt;PPR / Leiden&lt;/span&gt; = retrieval and community structure &amp;nbsp; • &amp;nbsp; &lt;span style=&quot;color:#D17CB7&quot;&gt;LLM&lt;/span&gt; = semantic adjudication over supplied evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#C9D5E5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;font style=&quot;font-size:11px;color:#5D6C80&quot;&gt;The two branches share the same parsed survey representation but use different evidence paths: integrity checks retrieve counterevidence or contradictions, whereas sufficiency checks retrieve and rank candidates for human inspection.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E2F0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="815" width="1500" height="55" as="geometry"/></mxCell>

        <mxCell id="lineLeft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8595DE;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="parse" target="integrityHeader"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lineRight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#62B99E;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="pool" target="suffHeader"><mxGeometry relative="1" as="geometry"/></mxCell>
